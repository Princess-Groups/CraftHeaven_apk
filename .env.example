# Copy this file to .env and fill in your values.
# NEVER commit the real .env (it is git-ignored).

# Supabase project — get these from Supabase Dashboard → Settings → API Keys
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# VITE_* vars are exposed to the browser bundle (publishable key only — never put service_role here)
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# ---- IndusInd Bank Payment Gateway (server-side only — NEVER expose to the browser) ----
# Merchant creds + endpoints are issued by the bank during merchant onboarding.
# Add these to your deployment (Vercel env) — the app only reads them on the server.
INDUSIND_MERCHANT_ID="your-merchant-id"
INDUSIND_SALT="your-salt"
# Sandbox until the bank promotes you to live. e.g. https://sandbox.indusindpg.com
INDUSIND_API_BASE="https://sandbox.indusindpg.com"
# Optional shared secret the gateway echoes on the callback (extra check on top of the signature)
INDUSIND_CALLBACK_SECRET=""
# Base public origin used to build return/callback URLs. Omit in production to use APP_URL.
APP_URL="http://localhost:3000"
# Optional overrides — default to APP_URL-derived paths.
# INDUSIND_CALLBACK_URL="https://your-app.vercel.app/api/payment/callback"
# INDUSIND_RETURN_URL="https://your-app.vercel.app/checkout"

# ---- Cashfree Payment Gateway (server-side only — NEVER expose to the browser) ----
# Credentials come from Cashfree Dashboard → Settings → API Keys.
# Use Sandbox keys to test (set CASHFREE_ENV="sandbox"), then switch to live keys
# (CASHFREE_ENV="production") when you're ready to take real payments.
CASHFREE_CLIENT_ID="your-client-id"
CASHFREE_CLIENT_SECRET="your-client-secret"
CASHFREE_ENV="sandbox"            # sandbox | production
CASHFREE_API_VERSION="2025-01-01"
# Optional shared secret used to verify Cashfree webhook signatures. Set this in
# Cashfree Dashboard webhook settings AND here — webhooks that fail verification
# are rejected.
CASHFREE_WEBHOOK_SECRET=""
# Optional overrides — default to APP_URL-derived paths.
# CASHFREE_API_BASE="https://sandbox.cashfree.com"
# CASHFREE_NOTIFY_URL="https://your-app.vercel.app/api/payment/cashfree-webhook"
# CASHFREE_RETURN_URL="https://your-app.vercel.app/checkout"
